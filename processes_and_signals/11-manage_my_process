#!/usr/bin/env bash
# This init script starts, stops or restarts the manage_my_process script
pid_file="/var/run/my_process.pid"
case "$1" in
	start)
		./manage_my_process &
		echo "$!" > "$pid_file"
		echo "manage_my_process started"
		;;
	stop)
		kill "$(cat "$pid_file")"
		rm -f "$pid_file"
		echo "manage_my_process stopped"
		;;
	restart)
		kill "$(cat "$pid_file")"
		rm -f "$pid_file"
		./manage_my_process &
		echo "$!" > "$pid_file"
		echo "manage_my_process restarted"
		;;
	*)
		echo "Usage: manage_my_process {start|stop|restart}"
		;;
esac
